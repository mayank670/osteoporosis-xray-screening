# Copy this file to ".env" and change the values for your machine.
# ".env" is git-ignored; this example file must never contain real secrets.

# Folder containing the labelled dataset (one sub-folder per class).
# Relative paths are resolved from the project root.
DATASET_DIR=data/raw

# Where trained models, training history and evaluation outputs are written.
ARTIFACTS_DIR=artifacts

# Private storage for uploaded scans and generated PDF reports.
UPLOADS_DIR=uploads
REPORTS_DIR=reports

# Used from Milestone 8 (Flask sessions). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=replace-me

# development | production   (production requires SECRET_KEY and HTTPS)
# APP_ENV=development

# Trained model used by the web app (created by scripts/promote_model.py)
# MODEL_DIR=artifacts/models/active

# Database (default: SQLite at instance/app.db)
# DATABASE_URL=sqlite:///instance/app.db

# Upload size limit and how long scans are kept (flask --app run purge-scans)
# MAX_UPLOAD_MB=10
# RETENTION_DAYS=90
